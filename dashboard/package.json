    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.1",
